#include "../Configs/Release.xcconfig"
MACOSX_DEPLOYMENT_TARGET = 12.0
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
ENABLE_HARDENED_RUNTIME = YES
SWIFT_VERSION = 5.0
CODE_SIGN_ENTITLEMENTS = Runner/Release/DeveloperID.entitlements
DEVELOPMENT_TEAM = $(NECARAMBA_TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER = $(NECARAMBA_BUNDLE_ID)
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Developer ID Application

NECARAMBA_DEVELOPMENT_RULES = NO
