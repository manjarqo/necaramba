#include "../Configs/AppInfo.xcconfig"
#include "../Configs/Release.xcconfig"
MACOSX_DEPLOYMENT_TARGET = 12.0
ARCHS = arm64 x86_64
ONLY_ACTIVE_ARCH = NO
ENABLE_HARDENED_RUNTIME = YES
SWIFT_VERSION = 5.0
FLUTTER_BUILD_MODE = release
CODE_SIGN_ENTITLEMENTS = Runner/Release/MAS.entitlements
DEVELOPMENT_TEAM = $(NECARAMBA_TEAM_ID)
PRODUCT_BUNDLE_IDENTIFIER = $(NECARAMBA_BUNDLE_ID)
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = Apple Distribution

NECARAMBA_DEVELOPMENT_RULES = NO
